<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/page" android:layout_width="match_parent" android:layout_height="match_parent"
    android:clipToPadding="true" android:background="@color/page">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingLeft="16dp" android:paddingRight="16dp"
        android:paddingTop="6dp" android:paddingBottom="8dp">
        <LinearLayout style="@style/MatrixRow" android:layout_marginBottom="6dp">
            <TextView style="@style/MatrixLabel" android:layout_width="0dp" android:layout_weight="1"
                android:text="@string/app_name" android:textSize="22sp" android:fontFamily="sans-serif-medium" />
            <Button android:id="@+id/log_button" style="@style/HeaderButton" android:text="≡" android:textSize="25sp"
                android:contentDescription="@string/open_log" android:tooltipText="@string/activity_log" />
            <Button android:id="@+id/help_button" style="@style/HeaderButton" android:text="ⓘ" android:textSize="24sp"
                android:contentDescription="@string/help" android:tooltipText="@string/help" />
        </LinearLayout>
        <LinearLayout style="@style/MatrixCard" android:layout_marginBottom="8dp">
            <LinearLayout style="@style/MatrixRow" android:layout_height="wrap_content">
                <TextView style="@style/MatrixLabel" android:layout_width="0dp" android:layout_weight="1"
                    android:text="@string/device" android:labelFor="@+id/device_picker" />
                <TextView android:id="@+id/connection_badge" style="@style/MatrixLabel" android:text="@string/offline"
                    android:textSize="11sp" android:textColor="@color/badge_text" android:gravity="center"
                    android:paddingLeft="10dp" android:paddingRight="10dp" android:paddingTop="4dp" android:paddingBottom="4dp"
                    android:background="@drawable/connection_badge" android:accessibilityLiveRegion="polite" />
            </LinearLayout>
            <TextView android:id="@+id/connection_message" style="@style/MatrixLabel" android:layout_width="match_parent"
                android:textColor="@color/error" android:visibility="gone" android:paddingTop="8dp"
                android:maxLines="2" android:ellipsize="end" android:accessibilityLiveRegion="polite" />
            <LinearLayout style="@style/MatrixRow" android:layout_marginTop="6dp">
                <FrameLayout android:id="@+id/device_field" android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:background="@drawable/device_field">
                    <Spinner android:id="@id/device_picker" android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="@android:color/transparent" android:contentDescription="@string/device_empty_accessibility" />
                    <TextView style="@style/MatrixLabel" android:layout_width="32dp" android:layout_height="match_parent"
                        android:layout_gravity="end" android:gravity="center" android:text="⌄" android:textSize="18sp"
                        android:textColor="@color/muted" android:importantForAccessibility="no" />
                </FrameLayout>
                <Button android:id="@+id/scan_button" style="@style/ConnectionButton" android:layout_width="68dp" android:text="@string/scan" />
                <Button android:id="@+id/connect_button" style="@style/ConnectionButton" android:layout_width="84dp" android:text="@string/connect" />
                <Button android:id="@+id/disconnect_button" style="@style/ConnectionButton" android:layout_width="92dp"
                    android:text="@string/disconnect" android:textColor="@color/muted" android:background="@drawable/quiet_button" android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/canvas_card" style="@style/MatrixCard" android:layout_height="0dp" android:layout_weight="1">
            <com.example.phonematrix.MatrixGridView android:id="@+id/matrix_grid"
                android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:contentDescription="@string/matrix_accessibility" />
            <LinearLayout style="@style/MatrixRow" android:layout_marginTop="4dp">
                <TextView android:id="@+id/canvas_status" style="@style/MatrixLabel" android:layout_width="0dp" android:layout_weight="1"
                    android:text="@string/draft" android:textColor="@color/canvas_text" android:accessibilityLiveRegion="polite" />
                <com.example.phonematrix.IconButton android:id="@+id/demo_button" style="@style/MatrixButton"
                    android:layout_width="52dp" android:layout_marginLeft="8dp" android:background="@drawable/play_button" app:matrixAction="Start demo" />
            </LinearLayout>
            <View style="@style/MatrixDivider" />
            <LinearLayout style="@style/MatrixRow">
                <com.example.phonematrix.IconButton android:id="@+id/heart_button" style="@style/WeightedButton" android:background="@drawable/heart_button" app:matrixAction="Heart" />
                <com.example.phonematrix.IconButton android:id="@+id/smile_button" style="@style/WeightedButton" android:layout_marginLeft="8dp" android:background="@drawable/smile_button" app:matrixAction="Smile" />
                <com.example.phonematrix.IconButton android:id="@+id/checker_button" style="@style/WeightedButton" android:layout_marginLeft="8dp" android:background="@drawable/checker_button" app:matrixAction="Checker" />
                <com.example.phonematrix.IconButton android:id="@+id/clear_button" style="@style/WeightedButton" android:layout_marginLeft="8dp" android:background="@drawable/clear_button" app:matrixAction="Clear" />
            </LinearLayout>
            <View style="@style/MatrixDivider" />
            <LinearLayout style="@style/MatrixRow">
                <Button android:id="@+id/digit_1" style="@style/DigitButton" android:text="@string/digit_1" />
                <Button android:id="@+id/digit_2" style="@style/DigitButton" android:layout_marginLeft="8dp" android:text="@string/digit_2" />
                <Button android:id="@+id/digit_3" style="@style/DigitButton" android:layout_marginLeft="8dp" android:text="@string/digit_3" />
            </LinearLayout>
            <LinearLayout style="@style/MatrixRow" android:layout_marginTop="4dp">
                <Button android:id="@+id/digit_4" style="@style/DigitButton" android:text="@string/digit_4" />
                <Button android:id="@+id/digit_5" style="@style/DigitButton" android:layout_marginLeft="8dp" android:text="@string/digit_5" />
                <Button android:id="@+id/digit_6" style="@style/DigitButton" android:layout_marginLeft="8dp" android:text="@string/digit_6" />
            </LinearLayout>
            <LinearLayout style="@style/MatrixRow" android:layout_marginTop="4dp">
                <Button android:id="@+id/digit_7" style="@style/DigitButton" android:text="@string/digit_7" />
                <Button android:id="@+id/digit_8" style="@style/DigitButton" android:layout_marginLeft="8dp" android:text="@string/digit_8" />
                <Button android:id="@+id/digit_9" style="@style/DigitButton" android:layout_marginLeft="8dp" android:text="@string/digit_9" />
            </LinearLayout>
            <LinearLayout style="@style/MatrixRow" android:layout_marginTop="4dp">
                <Space android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" />
                <Button android:id="@+id/digit_0" style="@style/DigitButton" android:layout_marginLeft="8dp" android:text="@string/digit_0" />
                <Space android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginLeft="8dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
