<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/page</item>
        <item name="android:navigationBarColor">@color/page</item>
        <item name="android:windowBackground">@color/page</item>
    </style>
    <style name="MatrixLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="MatrixButton">
        <item name="android:layout_height">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingLeft">6dp</item>
        <item name="android:paddingRight">6dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:backgroundTint">@null</item>
    </style>
    <style name="HeaderButton" parent="MatrixButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:background">@drawable/header_button</item>
        <item name="android:textColor">@color/accent</item>
    </style>
    <style name="ConnectionButton" parent="MatrixButton">
        <item name="android:layout_marginLeft">6dp</item>
        <item name="android:background">@drawable/connection_button</item>
        <item name="android:textColor">@color/connection_text</item>
    </style>
    <style name="WeightedButton" parent="MatrixButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
    </style>
    <style name="DigitButton" parent="WeightedButton">
        <item name="android:background">@drawable/key_button</item>
        <item name="android:textSize">21sp</item>
    </style>
    <style name="MatrixCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:background">@drawable/card</item>
    </style>
    <style name="MatrixRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
    </style>
    <style name="MatrixDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:background">@color/line</item>
    </style>
</resources>
